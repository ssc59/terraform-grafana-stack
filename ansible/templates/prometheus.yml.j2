global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: terraform-docker-app
    metrics_path: /metrics
    static_configs:
      - targets:
          - "{{ pushgateway_ip }}:5000"

  - job_name: pushgateway
    honor_labels: true
    static_configs:
      - targets:
          - "{{ pushgateway_ip }}:9091"
